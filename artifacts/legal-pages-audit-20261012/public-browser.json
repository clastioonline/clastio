  "code_review": {
    "version_selector": "Live documents each have only v1.0, so the earlier-versions selector is correctly hidden. Historical selection was not exercised against account data.",
    "future_version_ordering": "Code treats versions[0] as current, but the API history includes all published/archived versions while default current() excludes future-effective versions. A future-effective published version can therefore be mislabeled as an earlier version and selecting it resets to the current document. This is a code-review finding, not an observed live multi-version failure.",
    "version_deep_links": "The public page keeps selected version in component state and does not read URL query parameters; the API supports ?version=.",
    "document_types": "Backend supports dmca but no DMCA document is published; frontend legal layout and sidebar whitelist only terms/privacy/acceptable_use/cookie/refund.",
