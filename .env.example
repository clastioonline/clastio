# AI Teacher Assistant configuration. Copy to .env and fill in what you need.
# Every value is optional for a local demo: with no AI key the app runs in demo mode with built-in sample content.
# All keys stay on the server. The browser only talks to the web app, which proxies /api to the API.

# --- Core -------------------------------------------------------------------------------------------------
# development | production
ENVIRONMENT=development
# The public origin of the web app: used in emails, WhatsApp links and OAuth callbacks
# (OAuth redirect URI: <PUBLIC_WEB_URL>/api/v1/auth/oauth/google/callback, same for microsoft)
PUBLIC_WEB_URL=http://localhost:3000
# Required in production (the API refuses to start with the default). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# set true when served over HTTPS
COOKIE_SECURE=false
# JSON list; only needed if a browser calls the API directly
CORS_ORIGINS=["http://localhost:3000"]
# JSON list of emails that get the admin role on sign-up
ADMIN_EMAILS=[]
LOG_LEVEL=INFO
SENTRY_DSN=

# --- Database / cache ------------------------------------------------------------------------------------
# Local development without Docker (docker compose sets these for you):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/teacher_assistant
# optional; enables shared rate limits across API instances
REDIS_URL=
# docker compose only
POSTGRES_PASSWORD=postgres

# --- AI providers ----------------------------------------------------------------------------------------
# Add at least one. Anthropic is the default for planning, writing, vision and QC; OpenAI is the default for
# embeddings and images. If a routed provider has no key, the router falls back to a configured provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# optional: any OpenAI-compatible endpoint
OPENAI_BASE_URL=
GEMINI_API_KEY=
# true forces built-in sample content (demos, tests)
AI_OFFLINE_MODE=false

# Model routing, "<provider>:<model>". Admins can also change these at runtime in Admin -> AI costs.
MODEL_PLANNING=anthropic:claude-opus-5
MODEL_CONTENT=anthropic:claude-sonnet-5
MODEL_FAST=anthropic:claude-haiku-4-5
MODEL_VISION=anthropic:claude-sonnet-5
MODEL_QC=anthropic:claude-haiku-4-5
MODEL_EMBEDDING=openai:text-embedding-3-small
MODEL_IMAGE=openai:gpt-image-1-mini
# Media studio videos: openai:sora-2 (4/8/12 s clips) or gemini:veo-3.0-fast-generate-001 (4-8 s)
MODEL_VIDEO=openai:sora-2
# must match the embedding model; changing it needs a migration
EMBEDDING_DIM=1536
AI_MAX_CONCURRENCY=6
# search CC-licensed images before generating one
OPENVERSE_ENABLED=true

# --- File storage ----------------------------------------------------------------------------------------
# local | s3 (any S3-compatible store: AWS, R2, MinIO)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=100
# optional ClamAV daemon for upload scanning
CLAMD_HOST=

# --- Billing (Dodo Payments) -----------------------------------------------------------------------------
# Merchant of record: collects and remits VAT/GST, cards, UPI and local methods. Dashboard -> Developer -> API keys.
# Webhook endpoint: <PUBLIC_WEB_URL>/api/v1/webhooks/dodo ; its signing secret goes in DODO_PAYMENTS_WEBHOOK_KEY.
# Product ids (pdt_...) for plans and media packs are set in Admin -> Payments & media (or DODO_PRODUCTS below).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode (test keys only work in test_mode)
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Optional JSON fallback, e.g. {"teacher_month":"pdt_...","teacher_year":"pdt_..."}
DODO_PRODUCTS={}

# --- Billing (Stripe) ------------------------------------------------------------------------------------
# Without Stripe, admins can still assign plans manually. Webhook endpoint: /api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON, e.g. {"teacher_monthly":"price_...","pro_monthly":"price_...","assistant_monthly":"price_..."}
STRIPE_PRICES={}

# --- WhatsApp (official Cloud API only) ------------------------------------------------------------------
# Without these, WhatsApp runs in simulation mode inside the app. Webhook endpoint: /api/v1/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me

# --- Sign-in ---------------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# e.g. smtp://user:pass@smtp.example.com:587 ; magic links are logged if unset
SMTP_URL=
EMAIL_FROM="AI Teacher Assistant <no-reply@example.com>"

# --- Docker compose --------------------------------------------------------------------------------------
# creates demo accounts; ignored when ENVIRONMENT=production
SEED_DEMO=true
WORKER_CONCURRENCY=4
