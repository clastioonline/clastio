# Import into the API, worker and scheduler services on Railway (or paid Render).
# Replace every REPLACE_* value. No real credentials are included.
ENVIRONMENT=production
PUBLIC_WEB_URL=https://clastio.online
CORS_ORIGINS=["https://clastio.online"]
COOKIE_SECURE=true
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql+asyncpg://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB_NAME
REDIS_URL=redis://REPLACE_REDIS_USER:REPLACE_REDIS_PASSWORD@REPLACE_REDIS_HOST:6379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=30
JOB_HEARTBEAT_S=30
RUN_JOBS_INLINE=false
SEED_DEMO=false
STORAGE_BACKEND=s3
S3_BUCKET=clastio
S3_REGION=auto
S3_ENDPOINT_URL=https://a51aa9b51da8011d8a8796c55cf437e9.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
MAX_UPLOAD_MB=25
SIGNED_URL_TTL_SECONDS=900
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# Optional fallback when RESEND_API_KEY is unset:
# SMTP_URL=smtps://resend:URL_ENCODED_RESEND_API_KEY@smtp.resend.com:465
EMAIL_FROM=Clastio <notifications@clastio.online>
# Start with offline test output. Enable live AI only after credentials, model routes,
# approved price cards and spending limits have been configured and reviewed.
AI_OFFLINE_MODE=true
OPENVERSE_ENABLED=false
AI_MAX_CONCURRENCY=2
AI_GLOBAL_CONCURRENCY=4
LOG_LEVEL=INFO
API_REQUEST_LOG=true
# WhatsApp credentials intentionally omitted. This does not hide the existing simulator UI.
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SK_LIVE_KEY
CLERK_ISSUER=https://clerk.clastio.online
# Paste the PEM public key from Clerk API Keys. Literal \n escapes are supported.
CLERK_JWT_KEY=REPLACE_WITH_CLERK_PEM_PUBLIC_KEY
