# Render frontend ONLY. Replace API_URL before building.
NODE_ENV=production
NODE_VERSION=22
NEXT_PUBLIC_SITE_URL=https://clastio.online
API_URL=https://REPLACE_WITH_RAILWAY_API_HOST
# Clerk production instance for clastio.online. Public key is embedded at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PK_LIVE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SK_LIVE_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
