# Dedicated production file. Do not use the local demo credentials.
APP_ENV_FILE=.env.production
APP_DOMAIN=clastio.online
PUBLIC_WEB_URL=https://clastio.online
SECRET_KEY=
POSTGRES_PASSWORD=
ENVIRONMENT=production
COOKIE_SECURE=true
SEED_DEMO=false
RUN_JOBS_INLINE=false
AI_OFFLINE_MODE=false
REDIS_URL=redis://redis:6379/0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
AI_MAX_CONCURRENCY=4
AI_GLOBAL_CONCURRENCY=8
MAX_UPLOAD_MB=25
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SMTP_URL=
SENTRY_DSN=
# Add only the provider credentials and integrations you intend to enable.
# Live AI still needs approved price cards and enabled budget controls in Admin.
