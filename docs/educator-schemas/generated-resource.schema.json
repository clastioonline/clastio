      "type": "integer"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "topic": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    },
    "subject": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "education_stage": {
      "enum": [
        "early_years",
        "primary",
        "secondary",
        "university"
      ],
      "title": "Education Stage",
      "type": "string"
    },
    "grade": {
      "anyOf": [
        {
          "maxLength": 30,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grade"
    },
    "curriculum": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Curriculum",
      "type": "string"
    },
    "language": {
      "maxLength": 10,
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "kind": {
      "enum": [
        "subject_primer",
        "study_guide"
      ],
      "title": "Kind",
      "type": "string"
    },
    "origin": {
      "const": "generated",
      "title": "Origin",
      "type": "string"
    },
    "overview": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Overview",
      "type": "string"
    },
    "chapters": {
      "items": {
        "$ref": "#/$defs/ResourceChapter"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Chapters",
      "type": "array"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "maxItems": 24,
      "title": "Source References",
      "type": "array"
    },
    "review_checks": {
      "$ref": "#/$defs/PlannerReview"
    }
  },
  "required": [
    "schema_version",
    "title",
    "topic",
    "subject",
    "education_stage",
    "curriculum",
    "language",
    "kind",
    "origin",
    "overview",
    "chapters",
    "source_references",
    "review_checks"
  ],
  "title": "GeneratedResourceContent",
  "type": "object"
}
