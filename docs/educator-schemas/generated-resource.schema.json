          "type": "array"
        },
        "worked_examples": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Worked Examples",
          "type": "array"
        },
        "uae_case_study": {
          "maxLength": 4000,
          "minLength": 1,
