        },
        "url_or_file_id": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Url Or File Id",
          "type": "string"
        },
        "page_or_section": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Page Or Section",
          "type": "string"
        },
        "relevance": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Relevance",
          "type": "string"
