          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "practice_questions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
