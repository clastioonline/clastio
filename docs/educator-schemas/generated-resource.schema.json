    "PlannerReview": {
      "additionalProperties": false,
      "properties": {
        "alignment_status": {
          "const": "teacher_review_required",
          "title": "Alignment Status",
          "type": "string"
        },
        "framework_references": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 20,
          "title": "Framework References",
          "type": "array"
        },
        "evidence_gaps": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Gaps",
          "type": "array"
        },
        "teacher_checks": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Teacher Checks",
          "type": "array"
        }
      },
      "required": [
        "alignment_status",
        "framework_references",
        "evidence_gaps",
        "teacher_checks"
      ],
      "title": "PlannerReview",
      "type": "object"
    },
    "ResourceChapter": {
